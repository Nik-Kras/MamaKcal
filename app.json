{
  "expo": {
    "name": "Калорії",
    "slug": "mamakcal",
    "scheme": "mamakcal",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F3EF",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F3EF"
    },
    "android": {
      "package": "com.nikkras.mamakcal",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1650B8"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.2.20"
          }
        }
      ],
      [
        "./plugins/withKotlinGradlePlugin",
        {
          "version": "2.2.20"
        }
      ],
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Камера потрібна, щоб сфотографувати тарілку.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Доступ до фото потрібен, щоб вибрати знімок страви.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-font",
      "./plugins/withReleaseSigning",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "organization": "mykyta-krasnytskyi",
          "project": "mamakcal"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
